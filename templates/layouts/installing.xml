<?xml version="1.0" encoding="UTF-8"?>
<Layout name="installing" version="1.0">
  <Page id="installing">
    <VBox padding="20" spacing="10">
      <Label text="@installing.title" font_size="20" />
      <Spacer height="20" />
      <ProgressBar id="progress" value="0" width="400" height="20" />
      <Spacer height="10" />
      <Label id="status" text="@installing.status" />
      <Spacer height="30" />
      <HBox spacing="10">
        <Spacer />
        <Button id="cancel" text="@common.cancel" width="100" height="32" />
      </HBox>
    </VBox>
  </Page>
</Layout>

