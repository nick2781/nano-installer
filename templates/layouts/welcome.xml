<?xml version="1.0" encoding="UTF-8"?>
<Layout name="Welcome" version="1.0.0">
  <Page>
    <VBox>
      <Image icon="assets/logo.png" width="200" height="60" />
      <Spacer height="20" />
      <Label text="欢迎使用" text_i18n="welcome.title" font_size="24" />
      <Spacer height="10" />
      <Label text="安装程序将引导您完成安装过程" text_i18n="welcome.subtitle" font_size="14" />
      <Spacer height="20" />
      <Label text="点击\"安装\"即表示您同意我们的服务条款和隐私政策" text_i18n="welcome.agreement" />
      <Spacer height="30" />
      <HBox>
        <Button id="custom_install" text="自定义安装" text_i18n="welcome.custom_install" width="100" />
        <Spacer width="10" />
        <Button id="install" text="安装" text_i18n="welcome.install" width="100" />
        <Spacer width="10" />
        <Button id="cancel" text="取消" text_i18n="welcome.cancel" width="100" />
      </HBox>
    </VBox>
  </Page>
</Layout>

