<?xml version="1.0" encoding="UTF-8"?>
<Layout name="Finish" version="1.0.0">
  <Page>
    <VBox>
      <Label text="安装完成" text_i18n="finish.title" font_size="20" />
      <Spacer height="20" />
      <Label text="应用程序已成功安装到您的计算机。" text_i18n="finish.message" />
      <Spacer height="20" />
      <Checkbox id="launch_app" text="立即启动" text_i18n="finish.launch" checked="true" />
      <Spacer height="30" />
      <HBox>
        <Button id="finish" text="完成" text_i18n="finish.finish" width="100" />
      </HBox>
    </VBox>
  </Page>
</Layout>

