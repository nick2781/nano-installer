---
import type { SidebarSection } from "@cloudflare/nimbus-docs/types";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import SearchTrigger from "./ui/search/SearchTrigger.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import { config } from "virtual:nimbus/config";
import { stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";
import { uiForPath } from "@/lib/ui";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden — pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
  sections?: SidebarSection[];
}

// `collection` is the tree the page is in and `entryId` is the page's name in
// it; LanguageSwitch uses the pair to reach the same page in the other
// language. Both arrive from the route through DocsLayout, and both are
// optional because the site root and the 404 page render this header bare.
const { collection, entryId, showSidebar = true, sections: sectionsProp } = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";
const chinese = collection === "zh-CN" || currentSlug.startsWith("/zh-CN");
const prefix = chinese ? "/zh-CN" : "";
const ui = uiForPath(Astro.url.pathname);
const sections =
  sectionsProp ?? [
    { label: chinese ? "指南" : "Guides", href: `${prefix}/guides/`, isActive: currentSlug.startsWith(`${prefix}/guides`) },
    { label: chinese ? "参考" : "Reference", href: `${prefix}/reference/`, isActive: currentSlug.startsWith(`${prefix}/reference`) },
    { label: chinese ? "项目" : "Project", href: `${prefix}/project/`, isActive: currentSlug.startsWith(`${prefix}/project`) },
  ];
const showSections = sections.length >= 2;
const homeHref = withBase(`${prefix}/`, import.meta.env.BASE_URL);
const resolveSectionHref = (href: string): string =>
  withBase(href, import.meta.env.BASE_URL);
---

<header class="sticky top-0 z-30 border-b border-border bg-card/95 backdrop-blur-lg">
  <div class="mx-auto max-w-[100rem] flex items-center justify-between gap-2 h-14 px-3 lg:px-6">
    <div class="flex items-center gap-3 min-w-0">
      <slot name="brand">
        <a href={homeHref} class="group flex items-center gap-2 shrink-0 no-underline">
          <img src={withBase("/assets/nano-technology.png", import.meta.env.BASE_URL)} width="26" height="26" alt="" class="hidden sm:block" />
          <span class="font-semibold text-sm text-foreground group-hover:text-primary transition-colors">
            {config.title}
          </span>
        </a>
      </slot>

      {showSections && (
        <nav aria-label={ui.navigation} class="hidden lg:flex items-center gap-1 ml-4 pl-4 border-l border-border h-6 min-w-0 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {sections.map((section) => (
            <a
              href={resolveSectionHref(section.href)}
              aria-current={section.isActive ? "page" : undefined}
              class:list={[
                "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors shrink-0 whitespace-nowrap",
                section.isActive
                  ? "text-foreground bg-accent"
                  : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
              ]}
            >
              {section.label}
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <slot name="actions" />
      <LanguageSwitch collection={collection} entryId={entryId} />
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          title="GitHub"
          target="_blank"
          rel="noopener"
          class="hidden sm:inline-flex text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label={ui.openNavigation}
          title={ui.openNavigation}
          data-menu-btn
          class="md:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
</header>
