---
/**
 * LinkCard — link-styled card with title, optional description, and
 * trailing arrow that nudges on hover. Title shifts to primary on hover.
 *
 *   <LinkCard title="Get started" description="5-min intro" href="/start" />
 *   <LinkCard title="Title only" href="/x" />
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  title: string;
  description?: string;
  href: string;
  icon?: string;
}

const { title, description, href, icon, class: className, ...attrs } = Astro.props;
---

<a
  href={href}
  class={cn(
    "group flex items-center gap-4 rounded-lg border border-border bg-card p-5 no-underline text-inherit transition-colors hover:border-border-strong hover:bg-accent",
    className,
  )}
  {...attrs}
>
  {icon && <Icon name={icon} class="shrink-0 w-6 h-6 text-muted-foreground transition-colors group-hover:text-primary" />}
  <div class="min-w-0 flex-1">
    <h3 class="m-0 text-base font-semibold leading-snug text-foreground transition-colors group-hover:text-primary">{title}</h3>
    {description && <p class="mt-1 text-sm leading-normal text-muted-foreground">{description}</p>}
  </div>
  <Icon
    name="ph:caret-right"
    class="shrink-0 w-4 h-4 text-muted-foreground transition-all group-hover:translate-x-0.5 group-hover:text-primary"
   
  />
</a>
