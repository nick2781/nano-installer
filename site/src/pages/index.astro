---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
import { getIndexedEntries, withBase } from "@cloudflare/nimbus-docs/runtime";

// Link through each page's entry: its `url` follows the site's
// `trailingSlash`, and a card whose page is gone drops out instead of 404ing.
// This home page is the language chooser for the two documentation trees; the
// blurbs are the repository index's own one-line descriptions of each.
const cards = [
  {
    collection: "docs",
    id: "README",
    blurb: "What this is, what a setup does today, and where to go next.",
  },
  {
    collection: "zh-CN",
    id: "README",
    blurb: "中文入口：这是什么、现在装出来是什么样、接下来看哪里。",
  },
];
const entries = await getIndexedEntries();
const links = cards.flatMap((card) => {
  const entry = entries.find(
    (e) => e.collection === card.collection && e.entry.id === card.id,
  );
  return entry
    ? [{ label: entry.title, blurb: card.blurb, href: withBase(entry.url, import.meta.env.BASE_URL) }]
    : [];
});
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-2xl w-full px-6 py-24">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {config.description}
      </p>

      {links.length > 0 && (
        <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {links.map((link) => (
            <a
              href={link.href}
              class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
            >
              <div class="font-medium text-foreground">{link.label}</div>
              <div class="mt-0.5 text-sm text-muted-foreground">{link.blurb}</div>
            </a>
          ))}
        </div>
      )}
    </main>
  </div>
</BaseLayout>
