---
// The Chinese tree lives in its own Astro collection (`zh-CN`), and Nimbus
// mounts a non-primary collection at `/<collection name>` — so this route file
// under `src/pages/zh-CN/` is what serves `/zh-CN/...`. Everything else is the
// same page composition as the root `[...slug].astro`.
import DocsLayout from "../../layouts/DocsLayout.astro";
import {
  getCollectionStaticPaths,
  getCollectionPage,
  getRouteFlags,
  getSidebar,
  getPrevNext,
  getBreadcrumbs,
  getEditUrl,
  getLastUpdated,
  getTOC,
  stripBase,
} from "@cloudflare/nimbus-docs/runtime";
import { components } from "../../components";
import { forLanguage } from "../../lib/languages";

export const prerender = true;
export const getStaticPaths = getCollectionStaticPaths("zh-CN");

// The collection type parameter is what narrows `entry` to this collection's
// schema (`getCollectionPage<C extends string>`); without it `entry` is `never`.
const page = await getCollectionPage<"zh-CN">(Astro);
if (page instanceof Response) return page;
const { entry, Content, headings, markdownUrl, ogImageUrl } = page;

const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

// `sidebar.items` holds both languages' groups in one list, so keep only this
// page's language (see src/lib/languages.ts). prev/next read the same filtered
// tree, which keeps the walk inside one language.
const sidebar = sidebarOn
  ? await getSidebar(currentSlug, {
      collection: entry.collection,
      transform: ({ tree }) => forLanguage(tree, entry.collection),
    })
  : false;
const prevNext = await getPrevNext(currentSlug, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
const editUrl = await getEditUrl(entry);
// Frontmatter wins; git is the fallback.
const lastUpdated = entry.data.lastUpdated ??
  await getLastUpdated(entry);
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const socialImage = entry.data.socialImage ?? ogImageUrl;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>
