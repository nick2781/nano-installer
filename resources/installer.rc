#include <windows.h>

// 应用程序图标（使用系统标准ID）
32512 ICON "../assets/logo.ico"
// 第一个图标（作为应用程序默认图标）
1 ICON "../assets/logo.ico"
// 备用ID
IDI_ICON1 ICON "../assets/logo.ico"

// 版本信息
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TapTap"
            VALUE "FileDescription", "TapTap 安装程序"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "installer"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "installer.exe"
            VALUE "ProductName", "TapTap"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

