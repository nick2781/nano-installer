<?xml version="1.0" encoding="utf-8"?>
<!-- MUI_UNPAGE_CONFIRM. The box the runtime reads to decide whether the user
     data goes with the product is `chkReserveData`; a page without it never
     removes anything of the user's. -->
<Page width="720" height="450" background="#FF1B1F27"
      border-radius="12" border-color="#33FFFFFF" border-width="1">

  <Label id="lblConfirm" position="absolute" left="40" top="132" width="640" height="60"
         text="@uninstall_confirm" font-size="18" font-weight="bold"
         color="#FFFFFFFF" wrap="true" textalign="center" />

  <Checkbox id="chkReserveData" position="absolute" left="40" top="216" width="640" height="24"
            text="@keep_data" font-size="13" color="#FFFFFFFF"
            checked="true" textalign="center" />

  <Button id="btnNotNow" action="close" text="@not_now"
          position="absolute" left="232" top="286" width="160" height="40"
          background="#1AFFFFFF" border-radius="10" font-size="14"
          color="#FFFFFFFF" cursor="hand" />

  <Button id="btnUninstall" action="uninstall" text="@uninstall_button"
          position="absolute" left="408" top="286" width="160" height="40"
          background="#FF1F6FEB" border-radius="10" font-size="14"
          font-weight="bold" color="#FFFFFFFF" cursor="hand" />
</Page>
