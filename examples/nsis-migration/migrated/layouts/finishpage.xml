<?xml version="1.0" encoding="utf-8"?>
<!-- MUI_PAGE_FINISH: `role: "finish"` in the configuration. Running what was
     just installed is a button on this page rather than a checkbox the task
     checks on its way out. -->
<Page width="720" height="450" background="#FF1B1F27"
      border-radius="12" border-color="#33FFFFFF" border-width="1">

  <Label id="lblComplete" position="absolute" left="40" top="140" width="640" height="36"
         text="@install_complete" font-size="24" font-weight="bold"
         color="#FFFFFFFF" textalign="center" />

  <Label id="lblVersion" position="absolute" left="40" top="184" width="640" height="22"
         text="@version_info" value-source="config:project.version" font-size="13"
         color="#8A93A0" textalign="center" />

  <Button id="btnRun" action="launch_app" text="@launch_button"
          position="absolute" left="256" top="252" width="208" height="40"
          background="#FF1F6FEB" border-radius="10" font-size="14"
          font-weight="bold" color="#FFFFFFFF" cursor="hand" />

  <Button id="btnFinish" action="finish" text="@finish_button"
          position="absolute" left="256" top="306" width="208" height="40"
          background="#1AFFFFFF" border-radius="10" font-size="14"
          color="#FFFFFFFF" cursor="hand" />
</Page>
