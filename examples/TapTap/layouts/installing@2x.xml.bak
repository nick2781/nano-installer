<?xml version="1.0" encoding="UTF-8"?>
<Layout name="Installing" version="1.0.0" width="1148" height="716">
  <Page>
    <VBox>
      <Label text="正在安装 TapTap" text_i18n="processing.title" font_size="40" />
      <Spacer height="40" />
      <ProgressBar id="progress" value="0" width="800" height="40" />
      <Spacer height="20" />
      <Label id="status" text="正在准备安装..." text_i18n="processing.progress" font_size="28" />
      <Spacer height="60" />
      <Button id="cancel" text="取消" text_i18n="processing.cancel" width="200" height="80" font_size="28" />
    </VBox>
  </Page>
</Layout>
