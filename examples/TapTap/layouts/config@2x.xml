<?xml version="1.0" encoding="UTF-8"?>
<Layout width="1148" height="716" dpi="2x">
  <!-- 背景图片 -->
  <Image 
    icon="assets/bg_main@2x.png" 
    x="0" y="0" 
    width="1148" height="716"
    fit="fill"
  />
  
  <!-- 关闭按钮 -->
  <Button 
    id="close_button"
    icon="assets/btn_close@2x.png" 
    x="1118" y="10" 
    width="30" height="30"
    action="close"
  />
  
  <!-- 语言选择 -->
  <ComboBox 
    id="language_selector"
    x="1018" y="10" 
    width="90" height="30"
    options="en-US,zh-CN,ja,ko,th,vi,ru,es,pt,id"
    default="zh-CN"
  />
  
  <!-- 标题 -->
  <Label 
    text="选择安装选项"
    x="574" y="100" 
    width="400" height="60"
    font_size="32"
    font_weight="bold"
    color="#FFFFFF"
    align="center"
  />
  
  <!-- 安装路径 -->
  <Label 
    text="安装路径�?
    x="100" y="200" 
    width="120" height="40"
    font_size="18"
    color="#FFFFFF"
  />
  
  <TextInput 
    id="install_path"
    x="240" y="200" 
    width="400" height="40"
    font_size="16"
    background_color="rgba(255,255,255,0.1)"
    border_color="#00C4B2"
    text="C:\Program Files\TapTap"
  />
  
  <Button 
    id="browse_button"
    icon="assets/btn_dialog@2x.png" 
    x="660" y="200" 
    width="120" height="40"
    text="浏览"
    font_size="16"
    action="browse_path"
  />
  
  <!-- 自定义选项按钮 -->
  <Button 
    id="custom_options_button"
    icon="assets/btn_dialog@2x.png" 
    x="100" y="280" 
    width="200" height="50"
    text="自定义选项"
    font_size="18"
    action="toggle_custom"
    arrow="down"
  />
  
  <!-- 自定义选项面板 -->
  <VBox 
    id="custom_panel"
    x="100" y="350" 
    width="800" height="200"
    background="assets/bg_color@2x.png"
    visible="false"
  >
    <!-- 协议和政�?-->
    <HBox x="0" y="0" width="800" height="40">
      <CheckBox 
        id="agree_terms"
        x="20" y="10" 
        width="20" height="20"
        checked="true"
      />
      <Label 
        text="我同意《用户协议》和《隐私政策�?
        x="50" y="5" 
        width="400" height="30"
        font_size="16"
        color="#FFFFFF"
      />
    </HBox>
    
    <!-- 分隔�?-->
    <Divider 
      x="20" y="50" 
      width="760" height="2"
      color="#00C4B2"
      opacity="0.2"
    />
    
    <!-- 桌面快捷方式 -->
    <HBox x="0" y="70" width="800" height="40">
      <CheckBox 
        id="desktop_shortcut"
        x="20" y="10" 
        width="20" height="20"
        checked="true"
      />
      <Label 
        text="创建桌面快捷方式"
        x="50" y="5" 
        width="200" height="30"
        font_size="16"
        color="#FFFFFF"
      />
    </HBox>
    
    <!-- 开始菜单快捷方�?-->
    <HBox x="0" y="120" width="800" height="40">
      <CheckBox 
        id="start_menu_shortcut"
        x="20" y="10" 
        width="20" height="20"
        checked="true"
      />
      <Label 
        text="创建开始菜单快捷方�?
        x="50" y="5" 
        width="200" height="30"
        font_size="16"
        color="#FFFFFF"
      />
    </HBox>
  </VBox>
  
  <!-- 安装按钮 -->
  <Button 
    id="install_button"
    icon="assets/btn_primary@2x.png" 
    x="574" y="600" 
    width="200" height="60"
    text="开始安�?
    font_size="20"
    action="install"
  />
  
  <!-- 返回按钮 -->
  <Button 
    id="back_button"
    icon="assets/btn_dialog@2x.png" 
    x="374" y="600" 
    width="120" height="60"
    text="返回"
    font_size="20"
    action="back"
  />
</Layout>
