<?xml version="1.0" encoding="utf-8"?>
<Page width="720" height="450"
      background="#FF181B22"
      background-image="assets/bg_installing.png"
      border-radius="12"
      border-color="#26FFFFFF"
      border-width="1">

  <Button id="btnMinimize" action="minimize"
          position="absolute" left="640" top="12" width="34" height="34"
          normal-image="file='assets/btn_minimize.png' dest='7,7,27,27' fade='160'"
          hover-image="file='assets/btn_minimize.png' dest='7,7,27,27'"
          pressed-image="file='assets/btn_minimize.png' dest='7,7,27,27'"
          cursor="hand" />

  <Button id="close" action="close_confirm"
          position="absolute" left="674" top="12" width="34" height="34"
          enabled="false"
          normal-image="file='assets/btn_close.png' dest='7,7,27,27' fade='160'"
          disabled-image="file='assets/btn_close.png' dest='7,7,27,27' fade='96'"
          hover-image="file='assets/btn_close.png' dest='7,7,27,27'"
          pressed-image="file='assets/btn_close.png' dest='7,7,27,27'"
          cursor="hand" />

  <ProgressBar id="slrProgress"
               position="absolute"
               left="72" top="326"
               width="576" height="10"
               progress="0"
               border-radius="5"
               bar-image="assets/bar_installing.png"
               background="#FF4C5868"
               enabled="false" />

  <Label id="progress_pos"
         position="absolute"
         left="72" top="359"
         width="576" height="18"
         text="@installing_text"
         value-source="status"
         font-size="14"
         color="#FFFFFFFF"
         text-align="center" />
</Page>
