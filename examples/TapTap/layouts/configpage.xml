<?xml version="1.0" encoding="utf-8"?>
<Page width="720" height="450"
      background="#FF181B22"
      background-image="assets/bg_main.png"
      border-radius="12"
      border-color="#26FFFFFF"
      border-width="1">

  <Select id="langSelect" action="switch_language" selected="zh-CN"
          position="absolute" left="528" top="16" width="96" height="26"
          font-size="12" color="#CCFFFFFF" border-color="#1AFFFFFF" border-width="1"
          border-radius="8" dropdown-image="assets/select-arrow.png"
          dropdown-open-image="assets/select-arrow-up.png"
          dropdown-icon-width="10" dropdown-icon-height="10"
          dropdown-image-width="7.272" dropdown-image-height="4.902"
          popup-width="127" popup-row-height="26" popup-padding="2"
          popup-background="#FF42515E"
          popup-selected-background="#FF495A68"
          popup-border-color="#33FFFFFF"
          popup-check-color="#FFFFFFFF">
    <Option value="zh-CN" text="简体中文" />
    <Option value="en-US" text="English" />
    <Option value="ru" text="Русский" />
  </Select>

  <Button id="btnMinimize" action="minimize"
          position="absolute" left="640" top="12" width="34" height="34"
          normal-image="file='assets/btn_minimize.png' dest='7,7,27,27' fade='160'"
          hover-image="file='assets/btn_minimize.png' dest='7,7,27,27'"
          pressed-image="file='assets/btn_minimize.png' dest='7,7,27,27'"
          cursor="hand" />

  <Button id="close" action="close_confirm"
          position="absolute" left="674" top="12" width="34" height="34"
          normal-image="file='assets/btn_close.png' dest='7,7,27,27' fade='160'"
          hover-image="file='assets/btn_close.png' dest='7,7,27,27'"
          pressed-image="file='assets/btn_close.png' dest='7,7,27,27'"
          cursor="hand" />

  <Image id="logo"
         src="assets/logo.png"
         position="absolute"
         left="260" top="100"
         width="200" height="58" />

  <Image id="tagline"
         src="assets/v2_logo_tagline.png"
         position="absolute"
         left="273" top="181"
         width="174" height="26" />

  <Button id="btnInstall" action="install"
          enabled-when="chkAgree:checked, editDir:valid"
          position="absolute"
          left="240" top="268"
          width="240" height="40"
          normal-image="assets/btn_primary.png"
          hover-image="assets/btn_hover.png"
          pressed-image="assets/btn_hover.png"
          disabled-image="assets/btn_disabled.png"
          font-size="14" font-weight="bold" color="#FFFFFFFF"
          text="@install_button" cursor="hand" />

  <Label id="lblVersion"
         position="absolute"
         left="0" top="332"
         width="720" height="18"
         text="@version_info"
         value-source="config:project.version"
         font-size="12"
         color="#FFFFFFFF"
         wrap="false"
         valign="center"
         textalign="center" />

  <Box id="moreconfiginfo"
       position="absolute"
       left="0" top="166"
       width="720" height="284"
       visible="false"
       background="#FF303F4B"
       border-radius="16"
       border-color="#33FFFFFF"
       border-width="1">

    <HBox position="absolute" left="40" top="40" width="640" height="40" align-items="center" item-spacing="12">
      <Box id="editDirWrap"
           width="468" height="40"
           background="#33000000"
           border-radius="8">
        <TextInput id="editDir"
                   required="true"
                   required-message="@dir_required"
                   position="absolute"
                   left="16"
                   top="11"
                   width="410"
                   height="18"
                   padding="0 0 0 0"
                   value-source="config:install.default_path"
                   font-size="14"
                   color="#CCFFFFFF"
                   cursor="text" />
        <Image id="editDirIcon"
               action="pick_directory"
               target="editDir"
               cursor="hand"
               position="absolute"
               left="436"
               top="12"
               src="assets/folder-icon.png"
               width="16"
               height="16" />
      </Box>

      <Button id="install" action="install"
              enabled-when="chkAgree:checked, editDir:valid"
              width="160" height="40"
              normal-image="assets/btn_primary.png"
              hover-image="assets/btn_hover.png"
              pressed-image="assets/btn_hover.png"
              disabled-image="assets/btn_disabled.png"
              font-size="12" font-weight="bold" color="#FFFFFFFF"
              text="@start_install_button" cursor="hand" />
    </HBox>

    <HBox position="absolute" left="40" top="96" width="640" height="18" align-items="center" item-spacing="26">
      <Label id="lblRequiredSpace" text="@required_space"
             value-source="config:install.required_space_mb" value-format="size-mb"
             color="#80FFFFFF" font-size="12" />
      <Label id="local_space" text="@available_space"
             value-source="disk-free:editDir" value-format="size"
             color="#80FFFFFF" font-size="12" />
    </HBox>

    <HBox position="absolute" left="40" top="146" width="640" height="18" align-items="center" item-spacing="40">
      <Checkbox id="chkShotcut" height="18" text="@shortcut_checkbox"
                font-size="12" color="#FFFFFFFF" checked="true"
                unchecked-image="file='assets/checkbox-0.png' dest='0,1,16,17'"
                checked-image="file='assets/checkbox-2.png' dest='0,1,16,17'" />

      <Checkbox id="chkTaskbar" height="18" text="@taskbar_checkbox"
                font-size="12" color="#FFFFFFFF" checked="true"
                unchecked-image="file='assets/checkbox-0.png' dest='0,1,16,17'"
                checked-image="file='assets/checkbox-2.png' dest='0,1,16,17'" />

      <Checkbox id="chkAutoRun" height="18" text="@autorun_checkbox"
                font-size="12" color="#FFFFFFFF" checked="false"
                unchecked-image="file='assets/checkbox-0.png' dest='0,1,16,17'"
                checked-image="file='assets/checkbox-2.png' dest='0,1,16,17'" />
    </HBox>

    <Label id="dirHint"
           value-source="field-error:editDir"
           position="absolute"
           left="40" top="168" width="640" height="16"
           font-size="12" color="#FFFF7A7A" />

    <Divider position="absolute" left="40" top="196" width="640" height="1" background="#33FFFFFF" />
  </Box>

  <HBox position="absolute" left="40" top="378" width="640" height="56"
        align-items="center" item-spacing="32">
    <Checkbox id="chkAgree"
              flex-grow="1" min-width="0" height="36"
              font-size="12"
              text="@agree_full" color="#CCFFFFFF" checked="false"
              linkcolor="#00C4B2"
              unchecked-image="file='assets/checkbox-0.png' dest='0,1,16,17'"
              checked-image="file='assets/checkbox-2.png' dest='0,1,16,17'" />

    <Spacer flex-grow="1" />

    <Button id="btnShowMore_wrap" action="toggle_panel:moreconfiginfo:show"
            width="184" height="56"
            flex-shrink="0"
            font-family="Microsoft YaHei"
            font-size="12" color="#FFFFFFFF" hover-color="#FFFFFFFF" cursor="hand">
      <Content id="showMore_content"
               layout="horizontal"
               horizontal-align="right"
               vertical-align="center"
               item-spacing="4">
        <Label id="showMore_text"
               value="@show_more"
               max-width="156"
               wrap="true"
               valign="center"
               textalign="right" />
        <Box id="showMore_badge"
             width="24" height="24"
             background="#1AFFFFFF"
             border-radius="46"
             justify-content="center"
             align-items="center">
          <Icon id="showMore_icon" src="assets/arrow-down.png" width="12" height="12" />
        </Box>
      </Content>
    </Button>

    <Button id="btnHideMore_wrap" action="toggle_panel:moreconfiginfo:hide"
            width="184" height="56" visible="false"
            flex-shrink="0"
            font-family="Microsoft YaHei"
            font-size="12" color="#FFFFFFFF" hover-color="#FFFFFFFF" cursor="hand">
      <Content id="hideMore_content"
               layout="horizontal"
               horizontal-align="right"
               vertical-align="center"
               item-spacing="4">
        <Label id="hideMore_text"
               value="@hide_more"
               max-width="156"
               wrap="true"
               valign="center"
               textalign="right" />
        <Box id="hideMore_badge"
             width="24" height="24"
             background="#1AFFFFFF"
             border-radius="46"
             justify-content="center"
             align-items="center">
          <Icon id="hideMore_icon" src="assets/arrow-up.png" width="12" height="12" />
        </Box>
      </Content>
    </Button>
  </HBox>
</Page>
