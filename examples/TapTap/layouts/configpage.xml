<?xml version="1.0" encoding="utf-8"?>
<Page width="574" height="358" background="#FF181B22" background-image="assets/bg_main.png">

  <!-- Top-right: Language | Minimize | Close — flush to corner -->
  <Select id="langSelect" action="switch_language" selected="zh-CN"
          position="absolute" left="420" top="8" width="85" height="24"
          font-size="12" color="#FFCCCCCC">
    <Option value="zh-CN" text="简体中文" />
    <Option value="zh-TW" text="繁體中文" />
    <Option value="en-US" text="English" />
    <Option value="ja" text="日本語" />
    <Option value="ko" text="한국어" />
    <Option value="th" text="ไทย" />
    <Option value="vi" text="Tiếng Việt" />
    <Option value="id" text="Indonesia" />
    <Option value="es" text="Español" />
    <Option value="pt" text="Português" />
    <Option value="ru" text="Русский" />
  </Select>
  <Button id="btnMinimize" action="minimize" position="absolute" left="512" top="8" width="24" height="24"
          font-size="14" color="#80FFFFFF" hover-color="#FFFFFFFF" text="—" cursor="hand" />
  <Button id="close" action="close_confirm" position="absolute" left="540" top="8" width="24" height="24"
          normal-image="file='assets/btn_close.png' dest='0,0,32,32' fade='160'"
          hover-image="file='assets/btn_close.png' dest='0,0,32,32'"
          pressed-image="file='assets/btn_close.png' dest='0,0,32,32'" cursor="hand" />

  <VBox width="100%" height="100%" align-items="center">

    <!-- Logo -->
    <Spacer height="70" />
    <Image id="logo" src="assets/logo.png" width="148" height="80" />

    <!-- Install Button -->
    <Button id="btnInstall" action="install" width="240" height="40" margin-top="55" align-self="center"
            normal-image="assets/btn_primary.png" hover-image="assets/btn_hover.png"
            pressed-image="assets/btn_hover.png" disabled-image="assets/btn_disabled.png"
            font-size="14" font-weight="bold" color="#FFFFFFFF" text="@install_button" cursor="hand" />

    <Spacer flex-grow="1" />

    <!-- Bottom row: Agreement checkbox with inline links + Custom Settings -->
    <HBox width="100%" height="40" padding="0 24" align-items="center">

      <!-- Single checkbox with inline [link](id) syntax — auto-sizes to text content -->
      <Checkbox id="chkAgree" height="20" font-size="11"
                text="@agree_full" color="#FF9CA3AF" checked="false"
                unchecked-image="file='assets/checkbox-0.png' dest='0,1,16,17'"
                checked-image="file='assets/checkbox-2.png' dest='0,1,16,17'" />

      <Spacer flex-grow="1" />

      <Button id="btnShowMore" action="toggle_panel:moreconfiginfo:show" height="20" text="@show_more_arrow" font-size="11"
              color="#FF9CA3AF" hover-color="#FFFFFFFF" cursor="hand" />
      <Button id="btnHideMore" action="toggle_panel:moreconfiginfo:hide" height="20" text="@hide_more_arrow" font-size="11"
              color="#FF9CA3AF" hover-color="#FFFFFFFF" cursor="hand" visible="false" />

    </HBox>

    <Spacer height="12" />

  </VBox>

  <!-- Expandable Config Panel -->
  <Overlay id="moreconfiginfo" visible="false"
           position="absolute" left="0" top="358" width="574" height="160"
           background="#FF181B22" background-image="assets/bg_color.png">
    <VBox width="100%" height="100%">
      <Divider width="100%" height="1" background="#3300C4B2" padding="0 16" />
      <Spacer height="24" />
      <HBox height="32" padding="0 40" align-items="center">
        <TextInput id="editDir" width="410" height="32" readonly="true"
                   color="#CCFFFFFF" background="#1AFFFFFF"
                   border-radius="8" padding="0 16" />
        <Spacer flex-grow="1" />
        <Button id="btnSelectDir" action="browse_folder" width="60" height="32" text="@browse"
                font-size="14" color="#FF00C4B2" hover-color="#FF00FFE8" cursor="hand" />
      </HBox>
      <HBox height="24" padding="5 40 0 40">
        <Label id="lblRequiredSpace" width="160" text="@required_space" color="#FF96A1A9" font-size="12" />
        <Label id="local_space" width="200" text="@available_space" color="#FF96A1A9" font-size="12" />
        <Spacer flex-grow="1" />
      </HBox>
      <HBox height="24" padding="20 40 0 40" align-items="center">
        <Checkbox id="chkShotcut" width="150" height="24" text="@shortcut_checkbox"
                  font-size="14" color="#FFFFFFFF" checked="true"
                  unchecked-image="file='assets/checkbox-0.png' dest='0,3,16,19'"
                  checked-image="file='assets/checkbox-2.png' dest='0,3,16,19'" />
        <Spacer width="24" />
        <Checkbox id="chkAutoRun" width="120" height="24" text="@autorun_checkbox"
                  font-size="14" color="#FFFFFF" checked="true"
                  unchecked-image="file='assets/checkbox-0.png' dest='0,3,16,19'"
                  checked-image="file='assets/checkbox-2.png' dest='0,3,16,19'" />
        <Spacer flex-grow="1" />
      </HBox>
    </VBox>
  </Overlay>
</Page>
