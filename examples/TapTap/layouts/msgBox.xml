<?xml version="1.0" encoding="utf-8"?>
<Page width="400" height="230" background="#FF2A3844"
      border-radius="16" border-color="#FF474B59" border-width="1">
  <VBox width="100%" height="100%" padding="1">

    <Spacer height="70" />

    <!-- Message -->
    <HBox height="24" justify-content="center">
      <Label id="lblMsg" text="" color="#FFFFFFFF" font-size="16" font-weight="bold"
             text-align="center" />
    </HBox>

    <Spacer height="64" />

    <!-- Buttons -->
    <HBox height="40" padding="0 32" justify-content="center" gap="16">
      <Button id="btnCancel" action="dialog_cancel" visible="false" text="@cancel" width="160" height="40"
              font-size="14" font-weight="bold" color="#FFFFFFFF"
              border-radius="12" text-align="center"
              normal-image="assets/btn_dialog.png" cursor="hand" />
      <Spacer id="centerPadding" width="72" />
      <Button id="btnOK" action="dialog_ok" text="@ok" width="160" height="40"
              font-size="14" font-weight="bold" color="#FFFFFFFF"
              border-radius="12" text-align="center"
              normal-image="assets/btn_dialog_primary.png" cursor="hand" />
    </HBox>

  </VBox>
</Page>
