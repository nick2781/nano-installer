<?xml version="1.0" encoding="utf-8"?>
<Page width="400" height="180" background="#FF2A3844"
      border-radius="16" border-color="#FF474B59" border-width="1">
  <VBox width="100%" height="100%" padding="1">

    <Spacer height="56" />

    <!-- Message -->
    <HBox width="100%" padding="0 32" justify-content="center">
      <Label id="lblMsg" text="@close_confirm_message" value-source="dialog:message"
             color="#FFFFFFFF" font-size="16" font-weight="bold"
             text-align="center" wrap="true" width="336" />
    </HBox>

    <Spacer flex-grow="1" />

    <!-- Buttons -->
    <HBox height="40" padding="0 32" justify-content="center" gap="16">
      <Button id="btnCancel" action="dialog_cancel" visible-with="dismiss"
              text="@cancel" value-source="dialog:dismiss" width="160" height="40"
              font-size="14" font-weight="bold" color="#FFFFFFFF"
              border-radius="12" text-align="center"
              normal-image="assets/btn_dialog.png" cursor="hand" />
      <Button id="btnOK" action="dialog_ok" text="@ok" value-source="dialog:accept"
              width="160" height="40"
              font-size="14" font-weight="bold" color="#FFFFFFFF"
              border-radius="12" text-align="center"
              normal-image="assets/btn_dialog_primary.png" cursor="hand" />
    </HBox>

  </VBox>
</Page>
