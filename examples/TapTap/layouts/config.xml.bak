<?xml version="1.0" encoding="UTF-8"?>
<!-- 配置页面 - 完全匹配 NSIS configpage.xml -->
<Layout name="ConfigPage" version="1.0.0" width="574" height="358">
  <Page background="assets/bg_main.png" width="574" height="358">
    <!-- 右上角关闭按钮（绝对定位，参考 NSIS inset="0,16,16,0"） -->
    <!-- 窗口宽度 574，右边距 16，按钮宽度 32（NSIS 1x 为 32x32），所以 x = 574 - 16 - 32 = 526 -->
    <!-- 注意：position 是相对于窗口左上角的坐标，右上角应该是窗口宽度减去按钮宽度和右边距 -->
    <Button id="close" position="526,16" width="32" height="32" style="text"
            normalimage="file='assets/btn_close.png' dest='0,0,32,32'"
            hotimage="file='assets/btn_close.png' dest='0,0,32,32'"
            pushedimage="file='assets/btn_close.png' dest='0,0,32,32'" />
    
    <VBox spacing="0">
      <!-- 顶部空白 96px - 对应 NSIS: <Control height="96" /> -->
      <Spacer height="96" />

      <!-- Logo：80px 高 - 对应 NSIS: <Control height="80" width="148" bkimage="assets/logo.png" padding="213,0,213,0" /> -->
      <HBox height="80">
        <Spacer width="213" />
        <Image icon="assets/logo.png" width="148" height="80" />
        <Spacer width="213" />
      </HBox>

      <!-- 安装按钮区域：55px(上边距) + 40px(按钮高) = 95px -->
      <!-- 对应 NSIS: <Button padding="167,55,167,0" width="240" height="40" /> -->
      <Spacer height="55" />
      <HBox height="40">
        <Spacer width="167" />
        <Button id="install" text="安装" text_i18n="config.install" width="240" height="40" style="primary" font_size="14" color="#FFFFFFFF"
                enabled="false"
                normalimage="assets/btn_primary.png"
                hotimage="assets/btn_hover.png"
                pushedimage="assets/btn_hover.png"
                disabledimage="assets/btn_disabled.png" />
        <Spacer width="167" />
      </HBox>

      <!-- 复选框区域：总高度 87px，内边距上35px + 内容17px + 下35px -->
      <!-- 对应 NSIS: <HorizontalLayout height="87" inset="40,35,40,35"> -->
      <!-- padding 格式: (top, right, bottom, left)，所以 inset(left,top,right,bottom) 转换为 padding(top,right,bottom,left) = (35,40,35,40) -->
      <!-- 增加上边距，让 checkbox 离按钮更远 -->
      <Spacer height="10" />
      <HBox height="87" padding="25,40,35,40">
        <!-- CheckBox: 使用 markdown 格式支持超链接 -->
        <!-- 格式: "同意[用户协议](agreement)和[隐私政策](policy)" -->
        <Checkbox id="agree_license" text="同意[用户协议](agreement)和[隐私政策](policy)" text_i18n="config.agree" width="250" height="20" font_size="12" color="#FFE4E8EC"
                  normalimage="file='assets/checkbox-0.png' dest='0,1,16,17'"
                  selectedimage="file='assets/checkbox-2.png' dest='0,1,16,17'"
                  textpadding="20,0,0,0" />

        <!-- 弹性空间（填充中间）-->
        <Spacer />

        <!-- 自定义安装按钮: width=80（右对齐），带箭头图标，textpadding="0,0,16,0" -->
        <Button id="show_more" text="自定义安装" text_i18n="config.show_more" width="80" height="20" style="text" font_size="12" color="#FFFFFFFF"
                normalimage="file='assets/arrow-down.png' dest='68,2,80,15'"
                hotimage="file='assets/arrow-down.png' dest='68,2,80,15'"
                pushedimage="file='assets/arrow-down.png' dest='68,2,80,15'"
                textpadding="0,0,16,0" />
      </HBox>

      <!-- 总计：96 + 80 + 55 + 40 + 10 + 87 = 368px，但窗口高度是 358px，所以需要调整 -->
      <!-- 实际：96 + 80 + 55 + 40 + 10 + 87 = 368px，超出 10px，但 NSIS 原版也是这样的布局 -->
    </VBox>
  </Page>
</Layout>
