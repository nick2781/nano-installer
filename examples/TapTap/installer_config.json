{
  "project": {
    "name": "TapTap",
    "version": "2026.9.22-rel.1",
    "file_version": "2026.9.22",
    "publisher": "易玩（上海）网络科技有限公司",
    "copyright": "© 2025 TapTap",
    "output_name": "TapTap"
  },
  "output": {
    "installer_name": "TapTap_Setup.exe",
    "installer_icon": "assets/logo.ico",
    "uninstaller_name": "uninst.exe",
    "uninstaller_icon": "assets/uninst.ico"
  },
  "install": {
    "exe_name": "TapTap.exe",
    "default_path": "C:\\Program Files\\TapTapTest",
    "required_space_mb": 200,
    "require_admin": true,
    "detect_running_process": true,
    "kill_process_on_install": true,
    "kill_process_on_uninstall": true
  },
  "registry": {
    "uninstall_key": "HKCU\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Uninstall\\\\TapTapTest"
  },
  "shortcuts": {
    "desktop_shortcut": true,
    "desktop_default": true,
    "start_menu": true,
    "start_menu_folder": "TapTapTest"
  },
  "autostart": {
    "enabled": true,
    "default": false,
    "registry_key": "HKLM\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run",
    "registry_value_name": "TapTapTest"
  },
  "localization": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US",
      "ru"
    ]
  },
  "links": {
    "terms_of_service": "https://www.taptap.cn/doc/terms/",
    "privacy_policy": "https://www.taptap.cn/doc/privacy-policy/",
    "help": "https://www.taptap.cn/help"
  },
  "resources": {
    "layouts_dir": "layouts",
    "assets_dir": "assets",
    "locales_dir": "locales",
    "payload_file": "payload/app.7z",
    "uninstaller_icon": "assets/uninst.ico"
  },
  "ui": {
    "dialog_layout": "layouts/msgBox.xml",
    "dpi_aware": true,
    "dpi_threshold": 144
  },
  "wizard": {
    "pages": [
      {
        "id": "config",
        "layout": "layouts/configpage.xml",
        "title": "安装选项"
      },
      {
        "id": "installing",
        "layout": "layouts/installingpage.xml",
        "title": "正在安装"
      },
      {
        "id": "finish",
        "layout": "layouts/finishpage.xml",
        "title": "安装完成"
      }
    ],
    "uninstall_pages": [
      {
        "id": "uninstall_confirm",
        "layout": "layouts/uninstallpage.xml",
        "title": "确认卸载"
      },
      {
        "id": "uninstall_progress",
        "layout": "layouts/uninstallingpage.xml",
        "title": "正在卸载"
      },
      {
        "id": "uninstall_finish",
        "layout": "layouts/uninstallfinishpage.xml",
        "title": "卸载完成"
      }
    ]
  },
  "uninstall": {
    "data_paths": [
      "%APPDATA%\\TapTapTest",
      "%LOCALAPPDATA%\\TapTapTest"
    ]
  },
  "advanced": {
    "silent_mode_support": true,
    "uninstall_mode_support": true
  }
}
